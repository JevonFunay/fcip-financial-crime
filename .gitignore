.DS_Store

# Docker
*.log

# Generated (reproducible via app/scripts/generate_bulk_transactions.py)
backend/sample_data/transactions_bulk.csv

# Local source files, including the user-supplied public CSV/archive. Keep
# provenance/checksums in docs; do not publish the source through this repo.
backend/sample_data/raw/

# The bridge writes its projection next to the dataset it read, including the
# historical shared dataset locations. Projections are never committed.
backend/sample_data/*/transactions_app_format.csv

# The full profile is not shared through git: at ~85 MB it would add that much
# to the history on every change, and it is reproducible byte-for-byte from the
# seed in ~6 s (python -m app.scripts.generate_raw_dataset --profile full).
backend/sample_data/Full/

# ML datasets/model files remain local. Reproduction requires the matching
# source checksum, code, profiles and seeds (docs/ML_DATA_ENGINE.md).
backend/ml_data/
backend/ml_models/

# Local database/configuration backups for reversible demo preparation.
# May contain password hashes or local credentials; never commit them.
backend/local_backups/
