JWT_SECRET_KEY=change-me-dev-secret-do-not-use-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
